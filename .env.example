AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your-server-side-key
AI_MODEL=deepseek-flash
AI_API_STYLE=chat
PORT=3210
HOST=127.0.0.1

# Public hosting: keep false until a dedicated key has a provider-enforced cap.
AI_ENABLED=false
AI_PROVIDER_BUDGET_CONFIRMED=false
AI_DAILY_CALL_LIMIT=100
AI_CLIENT_DAILY_CALL_LIMIT=20
AI_DAILY_OUTPUT_TOKEN_LIMIT=200000
AI_MAX_OUTPUT_TOKENS=12000
AI_MAX_INPUT_CHARS=120000
AI_MAX_CONCURRENT_CALLS=2
# Production requires an absolute server-private path; use durable storage.
# AI_USAGE_FILE=/var/lib/spu/ai-usage.json
# PRESENTER_PYTHON=/opt/voice-venv/bin/python
